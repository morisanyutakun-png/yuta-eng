# =====================================================================
#  模試PDFストア（/mock-exams） 環境変数テンプレート
#
#  本番（Vercel）では Project Settings → Environment Variables に設定します。
#  手元の開発では .env.local にコピーして実際の値を入れてください。
# =====================================================================

# --- Stripe 決済（必須・公開スイッチ兼用）----------------------------
# STRIPE_SECRET_KEY が未設定の間は、本番にデプロイしても /mock-exams 配下は 404（非公開）になります。
# Stripe の鍵を設定した時点で自動的に模試PDFストアが出現します。
# （手元の next dev で鍵を入れる前に画面だけ確認したい場合は STORE_PREVIEW=1 を設定）
# （緊急時にストアを一時閉鎖したい場合は STORE_ENABLED=false を設定）
# Stripe ダッシュボード → 開発者 → API キー
# テスト環境は sk_test_... / pk_test_...、本番は sk_live_... / pk_live_...
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe ダッシュボード → 開発者 → Webhook（送信先: https://yuta-eng.com/api/stripe/webhook）
# 手元で stripe listen --forward-to localhost:3000/api/stripe/webhook を使うときは、
# その場に表示される whsec_... を設定します。
STRIPE_WEBHOOK_SECRET=

# --- PDF ダウンロード署名（必須）-------------------------------------
# 購入完了ページから発行する期限付きダウンロードURL（15分有効）の署名鍵。
# 32文字以上のランダムな文字列を設定してください（例: openssl rand -base64 32）
STORE_DOWNLOAD_SECRET=

# --- 自動送信メール & 運営控え（Resend連携）------------------------
# 決済完了時に Resend から自動送信メール（教材PDF添付）と運営控えを送るための設定。
# RESEND_API_KEY を設定するだけでメール自動送信機能が自動的に有効化されます。
# Resend ダッシュボード → API Keys で作成した re_... を設定します。
RESEND_API_KEY=

# 購入確認メールの差出人（未設定時は MOSHI_MAIL_FROM または "大学別数学研究室 公式ストア <info@yuta-eng.com>" を自動適用）
STORE_MAIL_FROM="大学別数学研究室 公式ストア <info@yuta-eng.com>"

# 注文確定時の運営控え送信先（未設定時は morisan.yutakun@gmail.com を自動適用）
STORE_ADMIN_EMAIL=morisan.yutakun@gmail.com

# --- 有料 PDF の置き場所（どちらか一方・未設定ならリポジトリ内 sales/ が自動適用）-
# 1) リポジトリ内 sales/mock-exams/<id>/full.pdf をそのまま使う場合（推奨・設定不要）
#    next.config.ts の outputFileTracingIncludes により Vercel サーバーレス関数に自動バンドルされます。
#
# 2) 外部ストレージ（Cloudflare R2 / S3 / Vercel Blob）から配信する場合（任意）
#    <STORE_PDF_BASE_URL>/<examId>/<key>.pdf を中継取得します。
STORE_PDF_BASE_URL=
STORE_PDF_TOKEN=

# 手元の別フォルダを指定する場合（任意・通常は未設定でOK）
# STORE_PDF_DIR=

# --- ストア基本設定（任意）-----------------------------------------
# 決済後のリダイレクト先 URL の土台（本番で未設定なら https://yuta-eng.com が自動判定）
STORE_BASE_URL=

# 購入後に再ダウンロードできる日数（未設定なら既定値 365日）
STORE_ACCESS_DAYS=365

# --- データベース（任意・入試プレビューと共有可）-------------------
# DATABASE_URL があると注文・Webhook・ダウンロード回数を記録し、返金時の停止も行います。
# 未設定でも Stripe API 直接照会によりストア単体で完全自律動作します。
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require

