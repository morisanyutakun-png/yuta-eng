# =====================================================================
#  模試演習ストア（/mock-exams） 環境変数テンプレート
#
#  本番（Vercel）では Project Settings → Environment Variables に設定します。
#  手元の開発では .env.local にコピーして実際の値を入れてください。
# =====================================================================

# --- Stripe 決済（必須・公開スイッチ兼用）----------------------------
# STRIPE_SECRET_KEY が未設定の間は、本番にデプロイしても /mock-exams 配下は 404（非公開）になります。
# Stripe の鍵を設定した時点で自動的に模試演習ストアが出現します。
# （手元の next dev で鍵を入れる前に画面だけ確認したい場合は STORE_PREVIEW=1 を設定）
# （緊急時にストアを一時閉鎖したい場合は STORE_ENABLED=false を設定）
# Stripe ダッシュボード → 開発者 → API キー
# テスト環境は sk_test_... / pk_test_...、本番は sk_live_... / pk_live_...
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe ダッシュボード → 開発者 → Webhook（送信先: https://yuta-eng.com/api/stripe/webhook）
# 手元で stripe listen --forward-to localhost:3000/api/stripe/webhook を使うときは、
# その場に表示される whsec_... を設定します。
STRIPE_WEBHOOK_SECRET=

# --- PDF ダウンロード署名（必須）-------------------------------------
# 購入完了ページから発行する期限付きダウンロードURL（15分有効）の署名鍵。
# 32文字以上のランダムな文字列を設定してください（例: openssl rand -base64 32）
STORE_DOWNLOAD_SECRET=

# --- 有料 PDF の置き場所（どちらか一方）------------------------------
# 1) 手元のフォルダから配信する場合（開発時・自前サーバー）
#    未設定時の既定値は ~/模試演習ストア/_dist（scripts/build-mock-exam-pdf.py の出力先）
#    ※ public/ の下は指定できません（誰でも取得できる場所になるため）
STORE_PDF_DIR=

# 2) 非公開ストレージ（R2 / S3 / Vercel Blob 等）から中継配信する場合（Vercel 本番推奨）
#    <STORE_PDF_BASE_URL>/<examId>/<problems|answer-sheets|solutions|rubric>.pdf を取得します。
STORE_PDF_BASE_URL=
STORE_PDF_TOKEN=

# --- ストアの URL・期間・メール（任意）-------------------------------
# 決済後のリダイレクト先 URL の土台（本番で未設定なら https://yuta-eng.com）
STORE_BASE_URL=

# 購入後に再ダウンロードできる日数（未設定なら data/mock-exams.ts の既定値 90 日）
STORE_ACCESS_DAYS=90

# 購入確認メールの差出人（RESEND_API_KEY があるときのみ送信。未設定なら MOSHI_MAIL_FROM を使用）
STORE_MAIL_FROM=

# --- 既存の共通設定（任意・入試プレビューと共有可）------------------
# DATABASE_URL があると注文・Webhook・ダウンロード回数を記録し、返金時の停止も行います。
# 未設定でも毎回 Stripe API に直接照会して購入確認を行うためストア単体で動作します。
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

